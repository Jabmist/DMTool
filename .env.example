NODE_ENV=production
PORT=3000

# Generate both with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me

# Token lifetimes in seconds (15 min access, 7 day refresh)
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# Production origin of the frontend (used for CORS); set to your domain
CLIENT_ORIGIN=https://your.domain.com

# ── AI note dissection (local Ollama) ─────────────────────────────────────────
# Base URL of your Ollama server (no trailing slash)
OLLAMA_BASE_URL=http://192.168.1.173:11434
# Model to use — pick one with the "tools" capability (e.g. gemini-gemma4:12b, nemotron-3-nano)
OLLAMA_MODEL=gemini-gemma4:12b
# Optional: max output tokens (default 8192) and request timeout in ms (default 1800000)
#OLLAMA_MAX_TOKENS=8192
#OLLAMA_TIMEOUT_MS=1800000
# How long POST /api/dissect/warm waits for the model load before giving up (ms, default 120000)
#OLLAMA_WARM_TIMEOUT_MS=120000

# Absolute path to vault storage root
VAULT_ROOT=/opt/obsidian/data/vaults

# Absolute path to temp upload directory
UPLOAD_TMP=/opt/obsidian/data/uploads

# Absolute path to SQLite database file
DB_PATH=/opt/obsidian/data/obsidian.db

# Absolute path to system-backup storage (tar.gz archives, issue #19)
BACKUP_DIR=/opt/obsidian/data/backups
